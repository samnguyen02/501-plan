<div id="<%= dom_id team %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Ideathon year:</strong>
    <%= team.ideathon_year_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Team name:</strong>
    <%= team.team_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Unassigned:</strong>
    <%= team.unassigned? ? "Yes" : "No" %>
  </div>
</div>
