<% content_for :title, "Registration Successful" %>
<% content_for :head do %>
  <meta http-equiv="refresh" content="4;url=<%= root_path %>">
<% end %>

<div class="min-h-[60vh] flex flex-col items-center justify-center px-4 py-12">
  <div class="max-w-md w-full text-center space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 text-green-600" aria-hidden="true">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Registration successful</h1>
    <p class="text-gray-600">
      Thank you for registering. You’re all set for the event.
    </p>
    <p class="text-sm text-gray-500">
      Redirecting to Home in <span id="countdown">4</span> seconds…
    </p>
    <p class="pt-2">
      <%= link_to "Go to Home now", root_path, class: "inline-block rounded-lg px-5 py-2.5 bg-gray-900 text-white font-medium hover:bg-gray-800 transition-colors" %>
    </p>
  </div>
</div>

<script>
  (function() {
    var el = document.getElementById("countdown");
    if (!el) return;
    var n = 4;
    var t = setInterval(function() {
      n--;
      el.textContent = n;
      if (n <= 0) clearInterval(t);
    }, 1000);
  })();
</script>
