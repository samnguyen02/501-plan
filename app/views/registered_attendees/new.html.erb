<% content_for :title, "Register - TAMU Ideathon 2026" %>

<% content_for :head do %>
<style>
  .reg-card {
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .reg-input {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.2s ease;
  }
  .reg-input:focus {
    border-color: rgba(255, 215, 0, 0.5);
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.1);
    outline: none;
  }
  .reg-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }
  .reg-radio {
    accent-color: #FFD700;
  }
  .btn-submit {
    background: rgba(255, 215, 0, 0.15);
    border: 1px solid rgba(255, 215, 0, 0.4);
    transition: all 0.3s ease;
  }
  .btn-submit:hover {
    background: rgba(255, 215, 0, 0.25);
    box-shadow: 0 0 25px rgba(255, 215, 0, 0.15);
  }
  .divider {
    border-color: rgba(255, 255, 255, 0.1);
  }
  select.reg-input {
    color: white;
    background-color: rgba(30, 30, 40, 0.8);
  }
  select.reg-input option {
    color: white;
    background-color: #1a1a2e;
  }
  select.reg-input option:hover {
    background-color: rgba(255, 215, 0, 0.2);
  }
  select.reg-input option:checked {
    background: linear-gradient(rgba(255, 215, 0, 0.3), rgba(255, 215, 0, 0.3));
    background-color: #1a1a2e;
  }
</style>
<% end %>

<div class="min-h-screen px-4 py-8 sm:px-6 lg:px-8">
  <div class="max-w-lg mx-auto">
    <!-- Back link -->
    <div class="mb-6 text-center">
      <%= link_to root_path, class: "inline-flex items-center gap-2 text-white/50 hover:text-ideathon-yellow transition-colors text-sm" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Home
      <% end %>
    </div>

    <!-- Registration card -->
    <div class="reg-card rounded-2xl p-6 sm:p-8">
      <h1 class="font-urban-blocker text-3xl sm:text-4xl text-ideathon-yellow tracking-wide text-center mb-1">
        REGISTER
      </h1>
      <p class="text-white/40 text-sm text-center mb-8">
        Ideathon 2026
      </p>

      <!-- Errors -->
      <% if @registered_attendee.errors.any? %>
        <div class="mb-6 rounded-lg px-4 py-3 text-sm text-red-400" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25);">
          <p class="font-semibold mb-1"><%= pluralize(@registered_attendee.errors.count, "error") %> prevented registration:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @registered_attendee.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @registered_attendee, local: true do |f| %>
        <%= f.hidden_field :ideathon_year_id, value: @registered_attendee.ideathon_year_id, id: "ideathon_year_id" %>

        <!-- Attendee Info -->
        <h2 class="text-white/70 text-sm font-semibold uppercase tracking-wider mb-4">Attendee Info</h2>

        <div class="space-y-4">
          <div>
            <%= f.label :attendee_name, "Name", class: "block text-white/50 text-xs mb-1.5" %>
            <%= f.text_field :attendee_name,
              required: true,
              placeholder: "Your full name",
              class: "reg-input w-full rounded-lg px-4 py-3 text-white text-sm" %>
          </div>

          <div>
            <%= f.label :attendee_phone, "Phone", class: "block text-white/50 text-xs mb-1.5" %>
            <%= f.telephone_field :attendee_phone,
              required: true,
              placeholder: "e.g., 979-555-1234 (10 digits)",
              class: "reg-input w-full rounded-lg px-4 py-3 text-white text-sm" %>
            <p class="text-white/30 text-xs mt-1">Must be exactly 10 digits</p>
          </div>

          <div>
            <%= f.label :attendee_email, "Email", class: "block text-white/50 text-xs mb-1.5" %>
            <%= f.email_field :attendee_email,
              required: true,
              placeholder: "name@email.com",
              class: "reg-input w-full rounded-lg px-4 py-3 text-white text-sm" %>
          </div>

          <div>
            <%= f.label :attendee_major, "Major", class: "block text-white/50 text-xs mb-1.5" %>
            <%= f.text_field :attendee_major,
              required: true,
              placeholder: "e.g., Computer Science",
              class: "reg-input w-full rounded-lg px-4 py-3 text-white text-sm" %>
          </div>

          <div>
            <%= f.label :attendee_class, "Classification", class: "block text-white/50 text-xs mb-1.5" %>
            <%= f.text_field :attendee_class,
              required: true,
              placeholder: "e.g., Junior",
              class: "reg-input w-full rounded-lg px-4 py-3 text-white text-sm" %>
          </div>
        </div>

        <hr class="divider my-8">

        <!-- Team Selection -->
        <h2 class="text-white/70 text-sm font-semibold uppercase tracking-wider mb-4">Team</h2>

        <div class="space-y-4">
          <!-- Unassigned -->
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="team_choice" value="unassigned"
                   class="reg-radio mt-0.5"
                   <%= (params[:team_choice].blank? || params[:team_choice] == "unassigned") ? "checked" : "" %>>
            <div>
              <span class="text-white text-sm">I don't have a team</span>
              <p class="text-white/30 text-xs mt-0.5">You'll be placed in the unassigned pool</p>
            </div>
          </label>

          <!-- Existing team -->
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="team_choice" value="existing"
                   class="reg-radio mt-0.5"
                   <%= params[:team_choice] == "existing" ? "checked" : "" %>>
            <div class="flex-1">
              <span class="text-white text-sm">Join an existing team</span>
              <p class="text-white/30 text-xs mt-0.5 mb-2">Pick a team with space available (max 4 per team)</p>
              <% existing_teams = @teams.reject { |t| t.unassigned } %>
              <%= select_tag "existing_team_id",
                options_for_select(
                  [["-- Select a team --", ""]] + existing_teams.map { |t| ["#{t.team_name} (#{t.registered_attendees.count}/4 members)", t.id] },
                  params[:existing_team_id]
                ),
                class: "reg-input w-full rounded-lg px-4 py-2.5 text-white text-sm",
                id: "existing_team_select" %>
            </div>
          </label>

          <!-- New team -->
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="team_choice" value="new"
                   class="reg-radio mt-0.5"
                   <%= params[:team_choice] == "new" ? "checked" : "" %>>
            <div class="flex-1">
              <span class="text-white text-sm">Create a new team</span>
              <p class="text-white/30 text-xs mt-0.5 mb-2">Enter a unique name for your new team</p>
              <input type="text" name="new_team_name" id="new_team_name"
                     value="<%= params[:new_team_name] %>"
                     placeholder="Team name"
                     class="reg-input w-full rounded-lg px-4 py-2.5 text-white text-sm">
            </div>
          </label>
        </div>

        <%= f.hidden_field :team_id, value: "" %>

        <!-- Submit -->
        <div class="mt-8">
          <%= f.submit "Register",
            class: "btn-submit w-full rounded-xl px-6 py-4 text-ideathon-yellow font-semibold text-base cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
