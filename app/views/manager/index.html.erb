<% content_for :title, "Manager Dashboard - TAMU Ideathon 2026" %>

<% content_for :head do %>
<style>
  .glass-card {
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    transition: all 0.3s ease;
  }

  .glass-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 215, 0, 0.3);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.08);
  }

  .glass-search {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.75rem;
  }

  .glass-search:focus-within {
    border-color: rgba(255, 215, 0, 0.5);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.1);
  }

  .neon-yellow {
    color: #FFD700;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
  }

  .btn-delete {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
    transition: all 0.2s ease;
  }

  .btn-delete:hover {
    background: rgba(239, 68, 68, 0.3);
    border-color: rgba(239, 68, 68, 0.6);
    box-shadow: 0 0 15px rgba(239, 68, 68, 0.2);
  }

  .fade-in {
    animation: fadeIn 0.4s ease-out forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }
</style>
<% end %>

<div class="min-h-screen px-4 py-8 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Back Link -->
  <div class="mb-6 fade-in" style="animation-delay: 0.05s;">
    <%= link_to root_path, class: "inline-flex items-center gap-2 text-white/60 hover:text-ideathon-yellow transition-colors font-lilita-one text-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Home
    <% end %>
  </div>

  <!-- Header -->
  <div class="mb-8 fade-in" style="animation-delay: 0.1s;">
    <h1 class="font-urban-blocker text-4xl sm:text-5xl neon-yellow mb-2">
      MANAGER DASHBOARD
    </h1>
    <p class="font-lilita-one text-white/60 text-lg">
      <%= @attendees.count %> attendee<%= @attendees.count == 1 ? "" : "s" %> registered
    </p>
  </div>

  <!-- Search Bar -->
  <div class="mb-8 fade-in" style="animation-delay: 0.15s;">
    <%= form_with url: manager_index_path, method: :get, data: { controller: "manager-search", turbo_frame: "attendees_list" } do |f| %>
      <div class="glass-search flex items-center px-4 py-3">
        <svg class="w-5 h-5 text-white/40 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <%= f.text_field :query,
            value: params[:query],
            placeholder: "Search attendees by name...",
            autocomplete: "off",
            class: "bg-transparent border-none outline-none text-white font-lilita-one text-base w-full placeholder-white/30",
            data: { manager_search_target: "input", action: "input->manager-search#search" } %>
        <% if params[:query].present? %>
          <%= link_to manager_index_path, class: "text-white/40 hover:text-white ml-2 flex-shrink-0" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Attendee List -->
  <%= turbo_frame_tag "attendees_list" do %>
    <% if @attendees.any? %>
      <div class="grid gap-3">
        <% @attendees.each_with_index do |attendee, i| %>
          <div id="attendee_<%= attendee.id %>" class="glass-card p-4 sm:p-5 flex items-center justify-between gap-4 fade-in" style="animation-delay: <%= 0.2 + (i * 0.03) %>s;">
            <div class="flex-1 min-w-0">
              <h3 class="font-titan-one text-white text-base sm:text-lg truncate">
                <%= attendee.name %>
              </h3>
              <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 mt-1">
                <span class="flex items-center gap-1.5 text-white/50 text-sm font-lilita-one truncate">
                  <svg class="w-3.5 h-3.5 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  <%= attendee.email %>
                </span>
                <% if attendee.phone_number.present? %>
                  <span class="flex items-center gap-1.5 text-white/50 text-sm font-lilita-one">
                    <svg class="w-3.5 h-3.5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    <%= attendee.phone_number %>
                  </span>
                <% end %>
              </div>
            </div>
            <%= button_to manager_path(attendee), method: :delete,
                data: { turbo_confirm: "Remove #{attendee.name} from the attendee list?" },
                class: "btn-delete px-3 py-2 rounded-lg font-lilita-one text-sm flex-shrink-0" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-white/20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <p class="font-lilita-one text-white/40 text-lg">
          <% if params[:query].present? %>
            No attendees match "<%= params[:query] %>"
          <% else %>
            No attendees yet
          <% end %>
        </p>
      </div>
    <% end %>
  <% end %>
</div>
