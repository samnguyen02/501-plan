      <div class="text-center px-3 sm:px-4 py-1.5">
        <div class="font-titan-one text-lg sm:text-xl leading-none drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]" style="color: rgb(158, 194, 191);">24</div>
        <div class="font-lilita-one text-[9px] tracking-widest uppercase mt-0.5" style="color: rgb(215, 129, 112);">Hours</div>
      </div>
      <div class="hidden sm:block w-px h-6 bg-white/10"></div>
