<%# TAMU Ideathon 2026 landing page %>
<% content_for :title, "TAMU Ideathon 2026 - Where Ideas Come to Life" %>

<%# Consolidated Styles - Glassmorphism, animations, and reusable classes %>
<% content_for :head do %>
<style>
  * { -webkit-font-smoothing: antialiased; }

  /* Glass Effects */
  .glass {
    background: rgba(249, 225, 143, 0.30);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(249, 225, 143, 0.35);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    transform: translateZ(0);
  }

  .glass-solid {
    background: rgba(249, 225, 143, 0.40);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transform: translateZ(0);
  }

  /* Card Styles */
  .bento-card {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    transform: translateZ(0);
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.40);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.40);
  }

  .glass-card-subtle {
    background: rgba(255, 255, 255, 0.30);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  /* Shadows */
  .shadow-dark {
    box-shadow: 0 4px 6px rgba(0,0,0,0.4), 8px 8px 0px 0px rgba(0,0,0,0.7);
  }

  .shadow-glow {
    box-shadow: 0 0 30px rgba(255,215,0,0.3);
  }

  /* Glows */
  .glow-gold {
    box-shadow: 0 0 15px rgba(255,215,0,0.2);
  }

  .glow-green {
    box-shadow: 0 0 15px rgba(228,240,171,0.15);
  }

  /* Section Headers */
  .section-heading {
    font-family: 'Beach Day', sans-serif;
    font-size: clamp(2rem, 5vw, 3.75rem);
    color: white;
    margin-bottom: 1rem;
    drop-shadow: 0 0 40px rgba(255,255,255,0.2);
  }

  .section-subheading {
    font-family: 'Lilita One', sans-serif;
    font-size: 1.125rem;
    color: white;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Nav Links */
  .nav-link {
    font-family: 'Lilita One', sans-serif;
    color: white;
    transition: color 200ms, background-color 200ms;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
  }

  .nav-link:hover {
    color: #FFD700;
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* Badge */
  .event-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 9999px;
    padding: 0.375rem 1.25rem;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .event-badge-text {
    font-family: 'Lilita One', sans-serif;
    color: white;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
  }

  /* Animations */
  .animate-init { opacity: 0; }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  .mobile-menu-enter { animation: mobileMenuEnter 0.3s cubic-bezier(0.16,1,0.3,1) forwards; }
  .mobile-menu-exit  { animation: mobileMenuExit 0.25s ease-out forwards; }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  @keyframes mobileMenuEnter {
    0%   { opacity: 0; transform: translateY(-16px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes mobileMenuExit {
    0%   { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-16px); }
  }
</style>
<% end %>





