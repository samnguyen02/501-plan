        </h2>
        <p class="font-lilita-one text-lg text-white mb-8 max-w-xl mx-auto">
          Join 200+ fellow Aggies for 24 hours of creativity, collaboration, and competition. 
          Your next big idea is waiting.
        </p>
        
        <%= button_to admin_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: "false" }, class: "group relative bg-white text-gray-800 font-titan-one text-xl px-10 py-5 rounded-2xl shadow-dark hover:shadow-game-glow transform hover:scale-105 hover:-translate-y-1 transition-all duration-300 flex items-center gap-3 mx-auto border-2 border-white/90" do %>
