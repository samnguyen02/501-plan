              data-ideathon-nav-target="menuButton">
        <svg class="w-6 h-6 transition-transform duration-300" data-ideathon-nav-target="menuIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
    
    <!-- Mobile Menu -->
    <div class="hidden mt-2 glass-solid rounded-2xl p-4 md:hidden" data-ideathon-nav-target="mobileMenu">
      <div class="flex flex-col gap-1">
        <a href="#about" class="nav-link" data-action="click->ideathon-nav#closeMobile">About</a>
        <a href="#schedule" class="nav-link" data-action="click->ideathon-nav#closeMobile">Schedule</a>
        <a href="#prizes" class="nav-link" data-action="click->ideathon-nav#closeMobile">Prizes</a>
        <a href="#judges" class="nav-link" data-action="click->ideathon-nav#closeMobile">Judges</a>
        <a href="#rules" class="nav-link" data-action="click->ideathon-nav#closeMobile">Rules</a>
        <a href="#sponsors" class="nav-link" data-action="click->ideathon-nav#closeMobile">Sponsors</a>
        <a href="#faq" class="nav-link" data-action="click->ideathon-nav#closeMobile">FAQ</a>
        <div class="border-t border-white/10 my-2"></div>
