          border border-white/30 shadow-dark">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background-color: rgba(228, 240, 171, 0.15);">
          <svg class="w-6 h-6" fill="currentColor" style="color: rgb(228, 240, 171);" viewBox="0 0 24 24">
            <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h3 class="font-titan-one text-xl text-white mb-2">Team Formation</h3>
        <p class="font-lilita-one text-white text-sm">
          Teams of 2-4 members. Don't have one? We'll help you find your perfect match!
        </p>
      </div>
      
      <!-- Workshops -->
        <div class="bento-card bg-white/20 backdrop-blur-md rounded-3xl p-6 
          border border-white/30 shadow-dark">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background-color: rgba(192, 220, 238, 0.15);">
          <svg class="w-6 h-6" fill="currentColor" style="color: rgb(192, 220, 238);" viewBox="0 0 24 24">
            <path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
        </div>
        <h3 class="font-titan-one text-xl text-white mb-2">Workshops & Mentors</h3>
