            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span>Register with Google</span>
          <span class="absolute -top-3 -right-3 text-ideathon-navy text-xs font-bold px-3 py-1.5 rounded-full transform group-hover:scale-110 transition-transform shadow-lg" style="background-color: rgb(228, 240, 171);">@tamu.edu only</span>
        <% end %>
        
        <p class="font-lilita-one text-white text-sm mt-6">
          Registration closes February 25, 2026
        </p>
      </div>
    </div>
    
  </div>
</section>

  </div> <!-- Close z-10 content wrapper -->
</div> <!-- Close sections wrapper -->

