      </div>
    </div>
  </div>
</nav>


<%# Hero section - Full-bleed image with centered title overlay %>
<section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden" data-controller="ideathon-hero">
  
  <!-- Background Image - fixed to extend behind nav -->
  <div class="fixed inset-0 z-0">
    <img src="/images/background.jpeg" 
         alt="Subway Surfers" 
         class="w-full h-full object-cover object-center"
         loading="eager" />
  </div>
  
  <!-- Content -->
  <div class="relative z-10 text-center px-4 py-8 flex flex-col items-center justify-center w-full">
    
    <!-- Event Badge -->
    <div class="event-badge animate-init animate-fade-up">
      <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: rgb(228, 240, 171);"></span>
      <span class="event-badge-text">February 28 - March 1, 2026</span>
    </div>
    
    <!-- Main Title with 2026 badge positioned -->
    <div class="relative animate-init animate-fade-up-delay-1 mb-2">
      <h1 class="leading-[0.85] tracking-tight">
        <span class="block font-beachday text-7xl sm:text-8xl md:text-9xl lg:text-[10rem]
                     drop-shadow-[0_4px_12px_rgba(0,0,0,0.6)]"
              style="color: rgb(238, 136, 138); text-shadow: 0 0 60px rgba(255,255,255,0.8);">
          TAMU
        </span>
        <span class="relative inline-block">
          <span class="block font-beachday text-7xl sm:text-8xl md:text-9xl lg:text-[10rem]
                       drop-shadow-[0_6px_16px_rgba(0,0,0,0.6)]"
                style="color: rgb(238, 136, 138); text-shadow: 0 0 60px rgba(255,255,255,0.8);">
            IDEATHON
          </span>
          <!-- Year Badge - positioned at bottom right of IDEATHON -->
          <span class="absolute bottom-0 right-0 font-titan-one text-sm sm:text-base text-ideathon-navy 
                       px-3 py-0.5 rounded-full shadow-dark transform rotate-3"
                style="background: linear-gradient(to right, rgb(252, 240, 228), rgb(238, 136, 138));">
            2026
          </span>
        </span>
      </h1>
    </div>
    
    <!-- Tagline -->
    <p class="font-lilita-one text-lg sm:text-xl md:text-2xl text-white mb-1 animate-init animate-fade-up-delay-2
              drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]">
      Where Ideas Come to Life
    </p>
    
    <!-- Subtitle -->
    <p class="font-lilita-one text-sm sm:text-base text-white max-w-xl mx-auto mb-4 animate-init animate-fade-up-delay-3
              drop-shadow-[0_1px_4px_rgba(0,0,0,0.4)]">
      24 hours to innovate, create, and transform your boldest ideas into reality. 
      Join Texas A&M's premier ideathon experience.
    </p>
    
    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 animate-init animate-fade-up-delay-4 mb-3" id="register">
      
      <%= button_to admin_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: "false" }, class: "group relative bg-white text-gray-800 font-titan-one text-xs px-4 py-2 rounded-lg shadow-dark hover:shadow-game-glow transform hover:scale-105 hover:-translate-y-1 transition-all duration-300 flex items-center gap-2 min-w-[180px] justify-center border-2 border-white/90" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
