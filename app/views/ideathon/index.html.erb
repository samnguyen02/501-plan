      </div>
      <div class="hidden sm:block w-px h-6 bg-white/10"></div>
      <div class="text-center px-3 sm:px-4 py-1.5">
        <div class="font-titan-one text-lg sm:text-xl leading-none drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]" style="color: rgb(228, 240, 171);">200+</div>
        <div class="font-lilita-one text-[9px] tracking-widest uppercase mt-0.5" style="color: rgb(215, 129, 112);">Participants</div>
      </div>
      <div class="hidden sm:block w-px h-6 bg-white/10"></div>
      <div class="text-center px-3 sm:px-4 py-1.5">
        <div class="font-titan-one text-lg sm:text-xl leading-none drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]" style="color: rgb(192, 220, 238);">50+</div>
        <div class="font-lilita-one text-[9px] tracking-widest uppercase mt-0.5" style="color: rgb(215, 129, 112);">Teams</div>
      </div>
    </div>
    
  </div>
</section>


<%# Sections with background %>
<div class="relative" style="background: url('/images/scrolldown.jpeg'); background-attachment: fixed; background-size: cover; background-position: top center;">
  <!-- Dark overlay to focus on content -->
  <div class="absolute inset-0 bg-ideathon-navy/30 z-0"></div>
  <div class="relative z-10">

<%# About / Bento grid section %>
