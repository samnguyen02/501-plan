        <%= link_to new_registered_attendee_path, class: "text-ideathon-navy font-titan-one text-sm px-5 py-2.5 rounded-xl shadow-lg hover:shadow-game-glow transform hover:scale-105 hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2", style: "background: linear-gradient(to right, rgb(252, 240, 228), rgb(238, 136, 138));" do %>
