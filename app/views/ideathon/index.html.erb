              <div class="flex items-start gap-3">
                <div class="flex-shrink-0">
                  <div class="flex items-center justify-center h-6 w-6 rounded-lg border" style="background-color: rgba(249, 225, 143, 0.2); border-color: rgba(249, 225, 143, 0.3);">
                    <span class="font-titan-one text-xs" style="color: rgb(249, 225, 143);"><%= index + 1 %></span>
                  </div>
                </div>
                <div>
                  <h4 class="font-titan-one text-white text-sm mb-1"><%= rule[:title] %></h4>
                  <p class="font-lilita-one text-white text-sm"><%= rule[:description] %></p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div>
        <h3 class="font-titan-one text-xl mb-4" style="color: rgb(228, 240, 171);">Required Deliverables</h3>
        <div class="space-y-2">
          <% [
            "Pitch deck (PDF)",
            "Problem statement",
            "Prototype",
            "Proposed solution (video)",
            "Basic implementation plan",
            "Market or impact potential"
          ].each_with_index do |deliverable, index| %>
            <div class="bento-card bg-white/20 backdrop-blur-md rounded-xl p-6 border border-white/30 transition-all duration-300">
              <div class="flex items-center gap-3">
                <div class="flex items-center justify-center h-5 w-5 rounded-full border flex-shrink-0" style="background-color: rgba(228, 240, 171, 0.2); border-color: rgba(228, 240, 171, 0.3);">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" style="color: rgb(228, 240, 171);">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <p class="font-lilita-one text-white text-sm"><%= deliverable %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Important Notice -->
    <div class="mt-8 p-6 rounded-2xl border-2 backdrop-blur-sm" style="border-color: rgba(215, 129, 112, 0.5); background-color: rgba(215, 129, 112, 0.2);">
      <div class="flex items-start gap-4">
        <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24" style="color: rgb(215, 129, 112);">
          <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
        </svg>
        <div>
          <h4 class="font-titan-one mb-2" style="color: rgb(215, 129, 112);">Important Notice</h4>
          <p class="font-lilita-one text-white text-sm leading-relaxed">By registering and participating in TAMU Ideathon 2026, you acknowledge that you have read and agree to follow all rules and regulations. Violations may result in disqualification and loss of eligibility for prizes.</p>
        </div>
      </div>
    </div>
  </div>
</section>


<%# Final CTA section %>
<section class="relative z-10 py-20 px-4">
  <div class="max-w-4xl mx-auto">
    
    <div class="bento-card backdrop-blur-sm rounded-3xl p-10 text-center relative overflow-hidden glow-gold" style="background: linear-gradient(to bottom right, rgba(249, 225, 143, 0.15), rgba(238, 136, 138, 0.12)); border: 1px solid rgba(249, 225, 143, 0.4);">
      
      <div class="absolute top-0 right-0 w-40 h-40 rounded-full blur-3xl" style="background-color: rgba(249, 225, 143, 0.05);"></div>
