<% content_for :title, "Add Event - TAMU Ideathon" %>

<% content_for :head do %>
<style>
  .glass-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .glass-input {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
  }
  .glass-input:focus {
    border-color: rgba(255, 215, 0, 0.5);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.1);
    outline: none;
    background: rgba(255, 255, 255, 0.08);
  }
  .btn-save {
    background: rgba(255, 215, 0, 0.15);
    border: 1px solid rgba(255, 215, 0, 0.4);
    transition: all 0.2s ease;
  }
  .btn-save:hover {
    background: rgba(255, 215, 0, 0.25);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.2);
  }
  .btn-cancel {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
  }
  .btn-cancel:hover {
    background: rgba(255, 255, 255, 0.1);
  }
</style>
<% end %>

<div class="min-h-screen px-4 py-8 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    <!-- Top bar -->
    <div class="mb-8 flex items-center justify-between">
      <%= link_to manager_index_path(tab: "events"), class: "inline-flex items-center gap-2 text-ideathon-yellow/70 hover:text-ideathon-yellow transition-colors text-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Manager
      <% end %>
    </div>

    <div class="glass-card rounded-2xl p-6 sm:p-8">
      <h1 class="text-2xl font-urban-blocker text-ideathon-yellow tracking-wide mb-1">Add Event</h1>
      <p class="text-white/40 text-sm mb-8">Create a new event for the active Ideathon year.</p>

      <% if @ideathon_event.errors.any? %>
        <div class="mb-6 rounded-xl px-4 py-3 text-sm text-red-400" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25);">
          <% @ideathon_event.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: @ideathon_event, class: "space-y-5" do |f| %>
        <div>
          <label class="block text-white/60 text-xs font-medium mb-2">Event Name</label>
          <%= f.text_field :event_name, placeholder: "e.g. Opening Ceremony",
              class: "glass-input w-full rounded-xl px-4 py-3 text-white placeholder-white/25 text-sm" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-white/60 text-xs font-medium mb-2">Date</label>
            <%= f.date_field :event_date,
                class: "glass-input w-full rounded-xl px-4 py-3 text-white text-sm" %>
          </div>
          <div>
            <label class="block text-white/60 text-xs font-medium mb-2">Time</label>
            <%= f.time_field :event_time,
                class: "glass-input w-full rounded-xl px-4 py-3 text-white text-sm" %>
          </div>
        </div>

        <div>
          <label class="block text-white/60 text-xs font-medium mb-2">Description</label>
          <%= f.text_area :event_description, rows: 4, placeholder: "Brief description of the event...",
              class: "glass-input w-full rounded-xl px-4 py-3 text-white placeholder-white/25 text-sm resize-none" %>
        </div>

        <div class="flex gap-3 pt-2">
          <%= f.submit "Create Event", class: "btn-save rounded-xl px-6 py-3 text-ideathon-yellow font-semibold text-sm cursor-pointer" %>
          <%= link_to "Cancel", manager_index_path(tab: "events"), class: "btn-cancel rounded-xl px-6 py-3 text-white/50 font-semibold text-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
