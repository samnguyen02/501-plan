<div id="<%= dom_id ideathon_event %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Ideathon year:</strong>
    <%= ideathon_event.ideathon_year_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Event name:</strong>
    <%= ideathon_event.event_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Event description:</strong>
    <%= ideathon_event.event_description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Event date:</strong>
    <%= ideathon_event.event_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Event time:</strong>
    <%= ideathon_event.event_time %>
  </div>
</div>
