<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for(:title) || "TAMU Ideathon 2026" %></title>
  <meta name="description" content="Join Texas A&M's premier ideathon - 24 hours of innovation, creativity, and collaboration. February 28 - March 1, 2026.">
  
  <!-- Open Graph / Social -->
  <meta property="og:title" content="TAMU Ideathon 2026">
  <meta property="og:description" content="24 hours of innovation. $5,000+ in prizes. Join 200+ Aggies.">
  <meta property="og:type" content="website">
  
  <!-- Font Imports (Google Fonts for Titan One & Lilita One, custom for Urban Blocker) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Titan+One&display=swap" rel="stylesheet">
  
  <!-- Custom font-face for Beach Day -->
  <style>
    @font-face {
      font-family: 'Beach Day';
      src: url('/fonts/beachday.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }
    
    /* Smooth scroll behavior */
    html {
      scroll-behavior: smooth;
      margin: 0;
      padding: 0;
    }
    
    body {
      margin: 0;
      padding: 0;
    }
    
    /* Prevent scroll restoration issues */
    html:focus-within {
      scroll-behavior: smooth;
    }
    
    /* Custom scrollbar for the ideathon theme */
    ::-webkit-scrollbar {
      width: 10px;
    }
    
    ::-webkit-scrollbar-track {
      background: #060918;
    }
    
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, rgb(252, 240, 228) 0%, rgb(238, 136, 138) 100%);
      border-radius: 5px;
    }
    
    ::-webkit-scrollbar-thumb:hover {
      background: rgb(252, 240, 228);
    }
    
    /* Gradient backgrounds for decorative elements */
    .bg-gradient-radial {
      background: radial-gradient(ellipse at center, var(--tw-gradient-from) 0%, var(--tw-gradient-to) 70%);
    }
    
    /* Selection styling */
    ::selection {
      background: rgba(255, 215, 0, 0.35);
      color: white;
    }
  </style>
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  
  <!-- Force scroll to top on page load/refresh -->
  <script>
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
  </script>
  
  <%= content_for :head %>
</head>
<body class="min-h-screen bg-ideathon-navy font-lilita-one text-white antialiased overflow-x-hidden m-0 p-0">

  <% if flash[:alert].present? %>
    <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 px-4 py-3 rounded-xl shadow-lg text-sm" style="background: rgba(220, 38, 38, 0.9); color: white !important;">
      <%= flash[:alert] %>
    </div>
  <% elsif flash[:success].present? %>
    <div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 px-4 py-3 rounded-xl shadow-lg text-sm" style="background: rgba(22, 163, 74, 0.9); color: white !important;">
      <%= flash[:success] %>
    </div>
  <% end %>

  <main class="m-0 p-0">
    <%= yield %>
  </main>

  <!-- Custom confirm modal -->
  <div id="turbo-confirm-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4" style="background: rgba(127, 85, 81, 0.2); backdrop-filter: blur(4px);">
    <div class="w-72 rounded-2xl p-5" style="background: rgb(252, 240, 228); border: 1px solid rgba(238, 136, 138, 0.15); box-shadow: 0 25px 50px rgba(127, 85, 81, 0.15);">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex-shrink-0 rounded-full p-1.5" style="background: rgba(255, 49, 49, 0.15); border: 1px solid rgba(255, 49, 49, 0.3);">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: rgb(248, 113, 113);">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-sm" style="color: rgb(238, 136, 138);">Are you sure?</h3>
          <p id="turbo-confirm-message" class="text-xs leading-relaxed mt-0.5" style="color: rgba(127, 85, 81, 0.6);"></p>
        </div>
      </div>
      <div class="flex gap-2 justify-end">
        <button id="turbo-confirm-cancel" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(127, 85, 81, 0.2); color: rgba(127, 85, 81, 0.6);">
          Cancel
        </button>
        <button id="turbo-confirm-ok" class="px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all" style="background: rgba(255, 49, 49, 0.15); border: 1px solid rgba(255, 49, 49, 0.3); color: rgb(248, 113, 113);">
          Remove
        </button>
      </div>
    </div>
  </div>

</body>
</html>
