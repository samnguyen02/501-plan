<div id="<%= dom_id ideathon_year %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= ideathon_year.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= ideathon_year.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Location:</strong>
    <%= ideathon_year.location %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Start date:</strong>
    <%= ideathon_year.start_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">End date:</strong>
    <%= ideathon_year.end_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is active:</strong>
    <%= ideathon_year.is_active? ? "Yes" : "No" %>
  </div>
</div>
