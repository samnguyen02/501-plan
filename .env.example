# Google OAuth credentials
# Either naming convention works in this repo:
# - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (501-club-staging style)
# - GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET (devise style)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional alternate names (use only one pair if possible)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Comma, semicolon, or newline-separated admin email allowlist
ALLOWED_ADMIN_EMAILS=""
